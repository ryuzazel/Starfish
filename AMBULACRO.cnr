// Actuator tools for each arm. This is the MCP.
// tool ids:
//   0 read, 1 write, 2 http, 3 echo, 4 ask (local llama.cpp)      -> executor
//   6 gen   (ONE PART of a long answer)                           -> executor
//   13 think (one agent step)                                     -> executor
//   9 review (check an excerpt)                                   -> reviewer
//   7 skill (list/show skills), 8 mem (context), 12 compact       -> archivist
//   10 forge (create a skill)                                     -> skill creator
//   11 plan (outline for a large goal)                            -> planner
//   14 web (page text), 15 search (web search)                    -> researcher (execCmd -> tools/*.py)
//   16 code (model writes a program), 17 save (file in sandbox)   -> coder
//   18 sh (REAL terminal: any bash command, persistent cwd/env), 19 run (file in sandbox) -> operator
//      (execCmd -> tools/sandbox.sh -> tools/term.py). Inside the terminal, `search` and `web` are on PATH.
// Sandbox: read/write only inside starfish_workspace/ (create the folder), HTTP only to localhost.
//
// Local AI via llama.cpp (CnR interpreter builtins llamaStart/llamaConnect/llamaAsk):
//   * If the file ambModelPath (a .gguf) exists, Starfish starts `llama-server` by itself
//     (binary: LLAMA_SERVER_BIN environment variable, or `llama-server` on PATH).
//   * Otherwise, it connects to a llama-server that is already running at ambLlamaUrl
//     (or at the URL in the LLAMA_SERVER_URL environment variable).
//   * If neither exists, Starfish stays up; only the model tools fail.

Gather(Bundle MADREPORITO){}
Gather(Bundle CONTEXTO){}
Gather(Bundle SKILLS){}

var ambWorkspace = "starfish_workspace/";
var ambModelPath = "models/model.gguf";   // put your GGUF model here
var ambLlamaPort = 8080;
// Model context window (tokens). THIS NUMBER DRIVES every Starfish budget:
// tokens per part, injected context size, agent history. Keep it equal to -c below.
// More memory/GPU? Raise it (e.g. 32768 and "-c 32768 -ngl 99"). Low memory? Lower it (e.g. 8192).
var ambCtxTokens = 16384;
var ambLlamaArgs = "-c 16384";            // extra llama-server flags (e.g. "-c 16384 -ngl 99")
var ambLlamaUrl = "http://127.0.0.1:8080";
var ambLlamaMaxTokens = 2048;             // direct `ask:` (was 512)
var ambShellEnabled = 1;                  // 0 turns OFF sh/run/save/code (arms stop executing anything)
var ambCmdTimeout = 130;                  // seconds execCmd waits (term.py and sandbox.sh run have their own, shorter, STARFISH_CMD_TIMEOUT = 60)
var ambSegTokens = 1024;                  // tokens for one `gen:` part; the CCR adjusts it by level

var ambLlamaSystem = "You are the brain of an agent called Starfish. Answer accurately and completely; be brief only when the question is simple.";
var ambSysAgente = "[AGENT] You are the Starfish agent. Decide the next action. Always answer with ONE decision line: 'TOOL tool:argument' or 'FINAL complete answer'.";
var ambSysGerador = "[EXECUTOR] You are the EXECUTOR arm of Starfish and you write long, technically correct answers in parts. Rules: (1) write ONLY the text of the requested part, without commenting on what you are doing; (2) continue exactly where the previous text stopped, without repeating or restarting; (3) follow the OUTLINE, the RULES and the CORRECTIONS you receive; (4) only state what you have reason to believe is true, and double-check numbers and code; (5) when the text is COMPLETE, end with the mark [END] on a final line; do not write [END] before that.";
var ambSysRevisor = "[REVIEWER] You are the REVIEWER arm of Starfish and you check the EXCERPT against the GOAL. Look for: false or invented claims (facts, definitions, technical terms, anatomy, dates, numbers), contradictions, wrong calculations, code that does not work, and violations of the RULES. Procedure: (1) in up to 4 short sentences, point out the riskiest claims in the excerpt and say whether each one is correct; (2) finish with ONE last line: 'VERDICT: OK' or 'VERDICT: ERROR <severity 1-3> | <what is wrong> | <how to fix it>'. Severity 1 = minor, 2 = relevant, 3 = severe (invented or unusable). Be rigorous: if you know a claim is wrong, it is an ERROR. An excerpt cut off mid-sentence is NOT an error. If there is no error you can point to, VERDICT: OK.";
var ambSysProgramador = "[CODER] You are the CODER arm of Starfish. Write ONE complete, runnable program for the GOAL. Prefer Python 3 (standard library only); use Bash for small shell tasks; use .js, .c or .cpp only if the GOAL asks for that language. Answer in exactly this format and nothing else: first line 'FILE: name.ext' (ext is .py or .sh by default; the name uses only letters, digits, underscore and dash), then ONE fenced code block with the whole program. The program takes no input, prints its result to stdout and finishes in under 30 seconds. It uses the network only if the GOAL needs it (bash programs have the commands search and web on PATH). If you receive an ERROR from a previous attempt, fix its cause and answer again in the same format.";
var ambSysPlanejador = "[PLANNER] You are the PLANNER arm of Starfish. For the given GOAL, list 3 to 8 numbered topics in the order they should be written, one per line, with no explanations.";
var ambSysFerreiro = "[SKILL CREATOR] You are the SKILL CREATOR arm of Starfish and you create SKILLS: short, reusable rules that prevent repeated mistakes. Answer ONLY with one line in the format: short-name-in-lowercase | imperative instruction of up to 300 characters.";
var ambSysArquivista = "[ARCHIVIST] You are the ARCHIVIST arm of Starfish. Condense the LESSONS you receive, keeping the most important rules and removing duplicates. Answer with one lesson per line, with no numbering and no comments.";

function ambStartsWith(var s, var prefix){
    var a = stringToChars(s);
    var b = stringToChars(prefix);
    if (len(a) < len(b)){
        return 0;
    }
    for(var i = 0; i < len(b); i++){
        if (a[i] != b[i]){
            return 0;
        }
    }
    return 1;
}

function ambHasDots(var s){
    var c = stringToChars(s);
    for(var i = 0; i + 1 < len(c); i++){
        if (c[i] == 46 && c[i+1] == 46){
            return 1;
        }
    }
    return 0;
}

// returns 1 if the string contains the given character code
function ambHasChar(var s, var code){
    var c = stringToChars(s);
    for(var i = 0; i < len(c); i++){
        if (c[i] == code){
            return 1;
        }
    }
    return 0;
}

// returns 1 only if the URL host is EXACTLY the given prefix (not "localhost.evil.com")
function ambUrlHasHost(var url, var prefix){
    if (ambStartsWith(url, prefix) == 0){
        return 0;
    }
    var u = stringToChars(url);
    var n = len(stringToChars(prefix));
    if (len(u) == n){
        return 1;
    }
    // the host must end here: ':' (58), '/' (47) or '?' (63)
    if (u[n] == 58 || u[n] == 47 || u[n] == 63){
        return 1;
    }
    return 0;
}

// ids of the "hand" tools (what an executor knows how to operate at the start)
function ambToolList(){
    var t[] = {0,1,2,3,4,6,13};
    return t;
}

// configured context window (tokens): base for the CCR budgets
function ambCtx(){
    return ambCtxTokens;
}

// the CCR adjusts how many tokens one `gen:` part may use (grows with the level)
function ambSetTokens(var n){
    var v = n;
    if (v < 64){ v = 64; }
    if (v > ambCtxTokens){ v = ambCtxTokens; }
    ambSegTokens = v;
}

function ambRead(var arg){
    if (ambHasDots(arg) == 1){
        Throw("invalid path");
    }
    var path = ambWorkspace + arg;
    if (fileExists(path)){
        return readFile(path);
    }
    Throw("file not found: " + arg);
}

function ambWrite(var arg){
    appendFile(ambWorkspace + "notes.txt", arg + "\n");
    return "noted";
}

function ambHttp(var arg){
    // '@' (64) is rejected to block tricks like http://localhost:80@evil.com
    if (ambHasChar(arg, 64) == 1){
        Throw("host not allowed");
    }
    if (ambUrlHasHost(arg, "http://localhost") == 0 && ambUrlHasHost(arg, "http://127.0.0.1") == 0){
        Throw("host not allowed");
    }
    var r = Http.GET(arg);
    return "status " + r.status + ": " + (string)r.body;
}

// Qwen3 models may return their reasoning inside <think>...</think>; drops everything up to </think>
function ambStripThink(var s){
    var c = stringToChars(s);
    var tag = stringToChars("</think>");
    var n = len(tag);
    var i = 0;
    var cut = -1;
    while(i + n <= len(c) && cut == -1){
        var match = 1;
        for(var j = 0; j < n; j++){
            if (c[i + j] != tag[j]){
                match = 0;
            }
        }
        if (match == 1){
            cut = i + n;
        }
        i = i + 1;
    }
    if (cut == -1){
        return s;
    }
    var[] rest;
    for(var q = cut; q < len(c); q++){
        rest.push(c[q]);
    }
    if (len(rest) == 0){
        return "";
    }
    return charsToString(rest);
}

// ---- tools that reach outside (researcher / coder / operator arms) -----------------------------
// The model's text NEVER goes on a command line: it is written to starfish_workspace/tool_arg.txt
// and the scripts in tools/ read it from there. Scripts report failure with a first line "ERROR: ...".

function ambWriteArg(var text){
    writeFile(ambWorkspace + "tool_arg.txt", text);
}

// result of a script: "ERROR: ..." becomes a failure (the arm is penalized), anything else is the result
function ambToolOut(var raw){
    var s = (string)raw;
    if (MADREPORITO.madStarts(MADREPORITO.madTrim(s), "ERROR") == 1){
        Throw(MADREPORITO.madTrim(s));
    }
    return s;
}

function ambShellGuard(){
    if (ambShellEnabled == 0){
        Throw("execution tools are disabled (ambShellEnabled = 0)");
    }
}

function ambWeb(var arg){
    ambWriteArg(arg);
    return ambToolOut(execCmd("python3 tools/web.py", ambCmdTimeout));
}

function ambSearch(var arg){
    ambWriteArg(arg);
    return ambToolOut(execCmd("python3 tools/search.py", ambCmdTimeout));
}

// file name allowed in the sandbox: letters, digits, _ - . (not starting with . or -), known extension
function ambSafeName(var name){
    var c = stringToChars(name);
    if (len(c) < 3 || len(c) > 60){
        return 0;
    }
    for(var i = 0; i < len(c); i++){
        var ch = c[i];
        var ok = 0;
        if (ch >= 48 && ch <= 57){ ok = 1; }
        if (ch >= 65 && ch <= 90){ ok = 1; }
        if (ch >= 97 && ch <= 122){ ok = 1; }
        if (ch == 95 || ch == 45 || ch == 46){ ok = 1; }
        if (ok == 0){ return 0; }
    }
    if (c[0] == 46 || c[0] == 45){
        return 0;
    }
    if (ambHasDots(name) == 1){
        return 0;
    }
    var okExt = 0;
    var exts[] = {".py", ".js", ".sh", ".c", ".cpp", ".txt", ".md", ".json"};
    for(var e = 0; e < len(exts); e++){
        var x = stringToChars(exts[e]);
        if (len(c) > len(x)){
            var same = 1;
            for(var k = 0; k < len(x); k++){
                if (c[len(c) - len(x) + k] != x[k]){
                    same = 0;
                }
            }
            if (same == 1){ okExt = 1; }
        }
    }
    return okExt;
}

// save:name.ext|content  -> writes starfish_workspace/Starfish_Work/name.ext (the first '|' separates name and content)
function ambSave(var arg){
    ambShellGuard();
    var bar = MADREPORITO.madIndexOf(arg, "|", 0);
    if (bar == -1){
        Throw("usage: save:name.ext|content");
    }
    var name = MADREPORITO.madTrim(MADREPORITO.madSub(arg, 0, bar));
    var content = MADREPORITO.madSub(arg, bar + 1, len(stringToChars(arg)));
    if (ambSafeName(name) == 0){
        Throw("invalid file name '" + name + "' (letters, digits, _ - . ; extensions: .py .js .sh .c .cpp .txt .md .json)");
    }
    execCmd("bash tools/sandbox.sh init", 5);   // makes sure starfish_workspace/Starfish_Work/ exists
    writeFile(ambWorkspace + "Starfish_Work/" + name, content);
    return "saved " + name + " (" + len(stringToChars(content)) + " bytes)";
}

// sh:command  -> one allowlisted command, no shell interpretation (see tools/sandbox.sh)
function ambSh(var arg){
    ambShellGuard();
    ambWriteArg(arg);
    return ambToolOut(execCmd("bash tools/sandbox.sh sh", ambCmdTimeout));
}

// run:file  -> runs a file from the sandbox (.py .js .sh .c .cpp); the output ends with [exit N]
function ambRunFile(var arg){
    ambShellGuard();
    ambWriteArg(arg);
    return ambToolOut(execCmd("bash tools/sandbox.sh run", ambCmdTimeout));
}

// starts/connects llama.cpp. Returns a status message (never takes Starfish down if it fails).
function ambBoot(){
    try {
        if (fileExists(ambModelPath)){
            llamaStart(ambModelPath, ambLlamaPort, ambLlamaArgs, 300);
            return "llama.cpp: model " + ambModelPath + " loaded on port " + ambLlamaPort + " (context " + ambCtxTokens + " tokens)";
        }
        llamaConnect(ambLlamaUrl);
        return "llama.cpp: using llama-server at " + ambLlamaUrl + " (assumed context: " + ambCtxTokens + " tokens)";
    } catch(var e) {
        return "llama.cpp UNAVAILABLE (model tools will fail): " + e;
    }
}

// model call with a role system prompt. The <think>...</think> reasoning is discarded.
function ambModel(var prompt, var system, var maxTokens, var temp){
    var txt = llamaAsk(prompt, system, maxTokens, temp);
    return ambStripThink((string)txt);
}

// direct question to the local model (`ask:` tool)
function ambAsk(var prompt){
    return ambModel(prompt, ambLlamaSystem, ambLlamaMaxTokens, 0.3);
}

// tool 7: skill:list | skill:show name
function ambSkillTool(var arg){
    var a = MADREPORITO.madTrim(arg);
    if (a == "" || a == "list"){
        return SKILLS.skList();
    }
    if (MADREPORITO.madStarts(a, "show") == 1){
        var nm = MADREPORITO.madTrimFrom(a, 4);
        var s = SKILLS.skShow(nm);
        if (s == ""){
            Throw("skill not found: " + nm);
        }
        return s;
    }
    Throw("usage: skill:list | skill:show name");
}

// tool 8: mem:list | mem:add lesson | mem:learn lesson | mem:find word | mem:count
function ambMemTool(var arg){
    var a = MADREPORITO.madTrim(arg);
    if (a == "" || a == "list"){
        return CONTEXTO.ctxDump(40);
    }
    if (a == "count"){
        return "" + CONTEXTO.ctxCount() + " lessons, " + CONTEXTO.ctxSize() + " characters";
    }
    if (MADREPORITO.madStarts(a, "learn") == 1){
        // lesson generated by Starfish itself (reviewer -> archivist), without the [manual] mark
        var auto = MADREPORITO.madTrimFrom(a, 5);
        if (auto == ""){
            Throw("mem:learn needs some text");
        }
        if (CONTEXTO.ctxAdd(auto) == 0){
            return "lesson already existed";
        }
        return "lesson saved";
    }
    if (MADREPORITO.madStarts(a, "add") == 1){
        var lesson = MADREPORITO.madTrimFrom(a, 3);
        if (lesson == ""){
            Throw("mem:add needs some text");
        }
        CONTEXTO.ctxAdd("[manual] " + lesson);
        return "lesson saved";
    }
    if (MADREPORITO.madStarts(a, "find") == 1){
        var q = MADREPORITO.madTrimFrom(a, 4);
        return CONTEXTO.ctxRecall(4000, q);
    }
    Throw("usage: mem:list | mem:add lesson | mem:learn lesson | mem:find word | mem:count");
}

function ambRun(var id, var arg){
    if (id == 0){ return ambRead(arg); }
    if (id == 1){ return ambWrite(arg); }
    if (id == 2){ return ambHttp(arg); }
    if (id == 3){ return arg; }
    if (id == 4){ return ambAsk(arg); }
    if (id == 6){ return ambModel(arg, ambSysGerador, ambSegTokens, 0.5); }
    if (id == 7){ return ambSkillTool(arg); }
    if (id == 8){ return ambMemTool(arg); }
    if (id == 9){ return ambModel(arg, ambSysRevisor, 500, 0.1); }
    if (id == 10){ return ambModel(arg, ambSysFerreiro, 500, 0.4); }
    if (id == 11){ return ambModel(arg, ambSysPlanejador, 500, 0.3); }
    if (id == 12){ return ambModel(arg, ambSysArquivista, 1500, 0.2); }
    if (id == 13){ return ambModel(arg, ambSysAgente, ambLlamaMaxTokens, 0.2); }
    if (id == 14){ return ambWeb(arg); }
    if (id == 15){ return ambSearch(arg); }
    if (id == 16){ ambShellGuard(); return ambModel(arg, ambSysProgramador, ambLlamaMaxTokens, 0.2); }
    if (id == 17){ return ambSave(arg); }
    if (id == 18){ return ambSh(arg); }
    if (id == 19){ return ambRunFile(arg); }
    Throw("unknown tool: " + id);
}

Bundle AMBULACRO{
    ambToolList();
    ambRun();
    ambBoot();
    ambCtx();
    ambSetTokens();
}